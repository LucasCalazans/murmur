# =====================================================================
# Murmur API — variáveis usadas dentro do container (apps/api).
# Em dev essas variáveis chegam pelo docker-compose (.env raiz),
# mas se rodar a API fora do container, copie pra apps/api/.env.
# =====================================================================

# App
APP_ENV=development
APP_PORT=3001
CORS_ORIGIN=http://localhost:5173

# Banco — `postgres` é o nome do serviço dentro da network docker.
# Se rodar a API fora do container, troque por `localhost`.
DATABASE_URL=postgresql+asyncpg://murmur:murmur_dev@postgres:5432/murmur
DATABASE_URL_SYNC=postgresql+psycopg://murmur:murmur_dev@postgres:5432/murmur

# Auth
JWT_SECRET=troque-isto-em-producao-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# LLM (camada plugável)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# Transcrição (faster-whisper)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=pt

# Armazenamento
AUDIO_STORAGE_PATH=/app/storage/audio
MAX_AUDIO_SIZE_MB=100
