# =====================================================================
# murmur — variáveis consumidas pelo docker-compose.
# Copie pra `.env` (sem o .example) e ajuste os valores.
# Frontend tem seu próprio arquivo em apps/web/.env.
# =====================================================================

# ---------- Postgres ----------
POSTGRES_USER=murmur
POSTGRES_PASSWORD=murmur_dev
POSTGRES_DB=murmur
POSTGRES_PORT=5432

# ---------- API ----------
API_PORT=3001
CORS_ORIGIN=http://localhost:5173

# ---------- Auth ----------
# Gere com: openssl rand -hex 32
JWT_SECRET=troque-isto-em-producao-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# ---------- LLM (camada plugável) ----------
# Provider ativo. Suportados: anthropic | openai | ollama
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6

# Use a chave do provider escolhido (deixe vazio nas outras).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Para usar Ollama local (rodando no host):
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# ---------- Transcrição (faster-whisper) ----------
# Tamanhos: tiny | base | small | medium | large-v3
# Em CPU comece com `base` (compromisso bom de qualidade/velocidade).
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu                  # use `cuda` se tiver GPU NVIDIA + nvidia-container-toolkit
WHISPER_COMPUTE_TYPE=int8           # int8 (cpu) | float16 (gpu) | float32
WHISPER_LANGUAGE=pt                 # ou `auto` pra detectar

# ---------- Áudio ----------
MAX_AUDIO_SIZE_MB=100
