# =====================================================================
# murmur — variáveis consumidas pelo docker-compose.
# Copie pra `.env` (sem o .example) e ajuste os valores.
# Frontend tem seu próprio arquivo em apps/web/.env.
# =====================================================================

# ---------- Postgres ----------
POSTGRES_USER=murmur
POSTGRES_PASSWORD=murmur_dev
POSTGRES_DB=murmur
# 5432 pode estar em uso por outro container — neste setup usamos 5433 no host.
POSTGRES_PORT=5433

# ---------- API ----------
API_PORT=3001
CORS_ORIGIN=http://localhost:5173

# ---------- Auth (Clerk) ----------
# Dashboard: https://dashboard.clerk.com → seu app → API keys.
# Secret key começa com `sk_test_` (dev) ou `sk_live_` (prod).
# Publishable key começa com `pk_test_` ou `pk_live_` — mesma do frontend.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Frontend(s) autorizado(s) a usar a sessão. Múltiplos: separados por vírgula.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
# Para webhook (sync user.created / user.deleted) — pegar em Webhooks > Signing secret.
CLERK_WEBHOOK_SECRET=

# Email do dono — primeiro login com esse email é promovido a role=owner.
OWNER_EMAIL=calazans95@hotmail.com

# ---------- LLM (camada plugável) ----------
# Provider ativo. Suportados: anthropic | openai | ollama
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6

# Use a chave do provider escolhido (deixe vazio nas outras).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Para usar Ollama local (rodando no host):
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# ---------- Transcrição (faster-whisper) ----------
# Tamanhos: tiny | base | small | medium | large-v3
# Em CPU comece com `base` (compromisso bom de qualidade/velocidade).
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu                  # use `cuda` se tiver GPU NVIDIA + nvidia-container-toolkit
WHISPER_COMPUTE_TYPE=int8           # int8 (cpu) | float16 (gpu) | float32
WHISPER_LANGUAGE=pt                 # ou `auto` pra detectar

# ---------- Áudio ----------
MAX_AUDIO_SIZE_MB=100
